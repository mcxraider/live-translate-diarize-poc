# DashScope credentials for Qwen3 LiveTranslate POC.
# Copy to .env and fill in, or just `export` these before `uv run server.py`.

DASHSCOPE_API_KEY=your_api_key_here

# Optional: model name (default below). e.g. qwen3.8-livetranslate-flash-realtime
# DASHSCOPE_MODEL=qwen3-livetranslate-flash-realtime

# Optional: full WebSocket URL override. Default is the single global endpoint:
#   wss://maas.qwencloudapi.com/api-ws/v1/realtime?model=<DASHSCOPE_MODEL>
# DASHSCOPE_WS_URL=

# OpenAI realtime translate (provider=openai)
OPENAI_API_KEY=your_openai_key_here
# Optional override, default below:
# OPENAI_TRANSLATE_MODEL=gpt-realtime-translate

# Gemini 3.5 Live Translate (provider=gemini). Agent Platform / Vertex — auth is
# ADC, not an API key: run `gcloud auth application-default login` on the server.
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_REGION=global
# Optional override, default below:
# GEMINI_MODEL=gemini-3.5-live-translate-preview
